{
  "name": "dev-digest-ai-marketplace-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "catalog": "node scripts/build-catalog.mjs",
    "catalog:fixtures": "node scripts/build-catalog.mjs --root test/fixtures --sample --history test/fixtures/history.json --repo humen-dev/dev-digest-ai-marketplace --out src/generated/catalog.fixtures.json",
    "predev": "npm run catalog",
    "dev": "vite",
    "dev:fixtures": "npm run catalog:fixtures && vite --mode fixtures",
    "prebuild": "npm run catalog",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  }
}
