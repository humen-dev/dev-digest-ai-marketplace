{
  "description": "sdd-engineering guards: limit what spec-creator, implementation-planner, implementer and plan-verifier may write or run. Inert for the main session and for every other agent.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/write-guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/bash-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
